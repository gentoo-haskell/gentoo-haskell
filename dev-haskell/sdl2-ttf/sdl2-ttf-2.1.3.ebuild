EAPI=8

# ebuild generated by hackport 0.9.1.0.9999

CABAL_FEATURES="lib profile haddock hoogle hscolour"
inherit haskell-cabal

DESCRIPTION="Bindings to SDL2_ttf"
HOMEPAGE="https://hackage.haskell.org/package/sdl2-ttf"

LICENSE="BSD"
SLOT="0/${PV}"
KEYWORDS="~amd64"
IUSE="example"

RDEPEND=">=dev-haskell/sdl2-2.2:=[profile?]
	>=dev-haskell/th-abstraction-0.4.0.0:=[profile?]
	>=dev-lang/ghc-9.0.2:=
	media-libs/libsdl2
	media-libs/sdl2-ttf
	>=dev-haskell/text-1.1.0.0:=[profile?]
	example? ( dev-haskell/text:=[profile?] )
"
DEPEND="${RDEPEND}
	>=dev-haskell/cabal-3.4.1.0
	virtual/pkgconfig
"

src_configure() {
	haskell-cabal_src_configure \
		$(cabal_flag example example)
}
