EAPI=8

# ebuild generated by hackport 0.9.1.0.9999
#hackport: flags: -old-mtl,install-examples:examples,-xhtml-library-needs-text

CABAL_FEATURES="lib profile haddock hoogle hscolour"
inherit haskell-cabal

DESCRIPTION="A library for writing CGI programs"
HOMEPAGE="https://github.com/cheecheeo/haskell-cgi"

LICENSE="BSD"
SLOT="0/${PV}"
KEYWORDS="~amd64"
IUSE="examples" # +xhtml-library-needs-text"

RDEPEND=">=dev-haskell/multipart-0.1.2:=[profile?] <dev-haskell/multipart-0.3:=[profile?]
	>=dev-haskell/network-uri-2.6:=[profile?] <dev-haskell/network-uri-2.7:=[profile?]
	>=dev-haskell/parsec-2.0:=[profile?] <dev-haskell/parsec-3.2:=[profile?]
	>=dev-lang/ghc-9.0.2:=
	>=dev-haskell/xhtml-3000:=[profile?] <dev-haskell/xhtml-3000.3:=[profile?]"

# haddock-api relies on <xhtml-3000.3, so bumping it would create a mess.
#	xhtml-library-needs-text? ( dev-haskell/text:=[profile?]
#					>=dev-haskell/xhtml-3000.3:=[profile?] <dev-haskell/xhtml-3000.5:=[profile?] )
#	!xhtml-library-needs-text? ( >=dev-haskell/xhtml-3000:=[profile?] <dev-haskell/xhtml-3000.3:=[profile?] )
DEPEND="${RDEPEND}
	>=dev-haskell/cabal-3.4.1.0
"

src_configure() {
	haskell-cabal_src_configure \
		$(cabal_flag examples install-examples) \
		--flag=-old-mtl \
		--flag=-xhtml-library-needs-text
}
