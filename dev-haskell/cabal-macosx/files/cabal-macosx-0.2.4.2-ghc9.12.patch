     let actual = getMacAppsForBuildableExecutors [] execs
     let expected = [ MacApp "Dummy One" Nothing Nothing [] [] DoNotChase
@@ -62,11 +74,11 @@ testBuildMacApp_twoBuildableExecutables = do
