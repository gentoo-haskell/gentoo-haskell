EAPI=8

# ebuild generated by hackport 0.9.1.0.9999
#hackport: flags: +minTime15,+splitBase

CABAL_PN="HDBC"

CABAL_FEATURES="lib profile haddock hoogle hscolour"
inherit haskell-cabal

DESCRIPTION="Haskell Database Connectivity"
HOMEPAGE="https://github.com/hdbc/hdbc"

LICENSE="BSD"
SLOT="0/${PV}"
KEYWORDS="~amd64"
IUSE="buildtests"

RDEPEND=">=dev-haskell/convertible-1.1.0.0:=[profile?]
	dev-haskell/old-time:=[profile?]
	dev-haskell/text:=[profile?]
	dev-haskell/utf8-string:=[profile?]
	>=dev-lang/ghc-9.0.2:=
	buildtests? ( dev-haskell/hunit:=[profile?]
			>=dev-haskell/quickcheck-2.0:=[profile?] )
"
DEPEND="${RDEPEND}
	>=dev-haskell/cabal-3.4.1.0
"

src_configure() {
	haskell-cabal_src_configure \
		$(cabal_flag buildtests buildtests) \
		--flag=minTime15 \
		--flag=splitBase
}
